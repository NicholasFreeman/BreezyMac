<?xml version="1.0" encoding="UTF-8"?>
<!--
  The app is NOT sandboxed: it needs IOKit/AppleSMC access for sensor reads and
  it installs an SMAppService LaunchDaemon, neither of which is permitted inside
  the App Sandbox.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
