    "helper.explain" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BreezyMac installiert ein kleines, privilegiertes Hilfsprogramm, um die Lüfterdrehzahlen zu ändern. Es bleibt inaktiv, bis ein aktiver Modus es benötigt, und gibt die Kontrolle an macOS zurück, sobald BreezyMac stoppt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BreezyMac installs a small privileged helper to change fan speeds. It stays dormant until an engaging mode needs it, and hands control back to macOS whenever BreezyMac stops."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BreezyMac installs a small privileged helper to change fan speeds. It stays dormant until an engaging mode needs it, and hands control back to macOS whenever BreezyMac stops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BreezyMac instala un pequeño asistente con privilegios para cambiar la velocidad de los ventiladores. Permanece inactivo hasta que un modo activo lo necesita y devuelve el control a macOS cuando BreezyMac se detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BreezyMac installe un petit assistant privilégié pour modifier la vitesse des ventilateurs. Il reste inactif jusqu'à ce qu'un mode actif en ait besoin, et rend le contrôle à macOS dès que BreezyMac s'arrête."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BreezyMac는 팬 속도를 변경하기 위해 권한이 있는 작은 도우미를 설치합니다. 이 도우미는 활성 모드가 필요로 할 때까지 대기 상태로 있다가, BreezyMac이 중지되면 제어권을 macOS에 반환합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O BreezyMac instala um pequeno assistente privilegiado para alterar a velocidade dos ventiladores. Ele permanece inativo até que um modo ativo precise dele e devolve o controle ao macOS sempre que o BreezyMac é interrompido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BreezyMac 会安装一个具有特权的小型辅助程序来调节风扇转速。它会保持休眠，直到某个启用模式需要它，并在 BreezyMac 停止时将控制权交还给 macOS。"
          }
        }
      }
    },
