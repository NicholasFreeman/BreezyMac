    "auto.note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch hält die Temperaturen unter der Drosselungsschwelle: Die Lüfter bleiben bis zum Zielwert leise, regeln zur Obergrenze hin hoch und springen unter thermischer Last auf Maximum. Die Sollwerte unterscheiden sich je nach Energiequelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic holds temperatures below the throttle threshold: fans stay quiet until the target, ramp toward the ceiling, and jump to maximum under thermal pressure. Setpoints differ per power source."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic holds temperatures below the throttle threshold: fans stay quiet until the target, ramp toward the ceiling, and jump to maximum under thermal pressure. Setpoints differ per power source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático mantiene las temperaturas por debajo del umbral de limitación: los ventiladores permanecen silenciosos hasta el objetivo, se aceleran hacia el máximo y saltan a la velocidad máxima bajo presión térmica. Los valores de referencia difieren según la fuente de alimentación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode automatique maintient les températures sous le seuil de bridage : les ventilateurs restent silencieux jusqu'à la cible, accélèrent vers le plafond et passent au maximum en cas de pression thermique. Les valeurs de consigne diffèrent selon la source d'alimentation."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 모드는 온도를 스로틀링 임계값 아래로 유지합니다. 팬은 목표값까지 조용히 유지되다가 상한값을 향해 속도를 높이고, 발열 부하가 커지면 최대 속도로 전환됩니다. 설정값은 전원에 따라 다릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo automático mantém as temperaturas abaixo do limite de throttling: os ventiladores ficam silenciosos até o alvo, aceleram em direção ao teto e saltam para o máximo sob pressão térmica. Os valores de referência variam conforme a fonte de alimentação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”模式将温度保持在降频阈值以下：风扇在达到目标值前保持安静，随后向上限提速，并在热压力下跃升至最高转速。设定值因电源而异。"
          }
        }
      }
    },
