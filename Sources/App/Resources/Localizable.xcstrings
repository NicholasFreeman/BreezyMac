          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background sampling to keep the charts warm while the popover is closed arrives in a later update."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background sampling to keep the charts warm while the popover is closed arrives in a later update."
