    "auto.spike.help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Werte lassen die Lüfter früher hochregeln, wenn die Temperatur schnell ansteigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher values ramp the fans earlier when temperature is rising quickly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher values ramp the fans earlier when temperature is rising quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores más altos aceleran los ventiladores antes cuando la temperatura sube rápidamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs plus élevées font accélérer les ventilateurs plus tôt lorsque la température monte rapidement."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값이 높을수록 온도가 빠르게 상승할 때 팬이 더 일찍 속도를 높입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais altos aceleram os ventiladores mais cedo quando a temperatura sobe rapidamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数值越高，当温度快速上升时风扇提速越早。"
          }
        }
      }
    },
