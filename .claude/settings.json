{
  "autoMemoryDirectory": "./.claude/memory",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(./.claude/*.json)"
    ],
    "allow": [
      "Read(./**/*)",
      "Edit(./**/*)",
      "Read(./CLAUDE.md)",
      "Edit(./CLAUDE.md)",
      "Create(./.claude/memory/**/*)",
      "Edit(./.claude/memory/**/*)",
      "Create(./docs/**/*)",
      "Edit(./docs/**/*)"
    ]
  }
}